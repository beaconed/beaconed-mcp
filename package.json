{
  "name": "@beaconed/mcp",
  "version": "0.0.4",
  "description": "Manage Beaconed products, readiness scores, AI optimizations, and webhooks.",
  "keywords": [
    "beaconed",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "ecommerce",
    "shopify",
    "seo"
  ],
  "author": "Beaconed, Inc.",
  "license": "MIT",
  "homepage": "https://github.com/beaconed/beaconed-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beaconed/beaconed-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/beaconed/beaconed-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "beaconed-mcp": "./dist/server.js"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "@beaconed/api-client": "github:beaconed/beaconed-api-client#43439ae7d80770ba6ce9fc85f78f1242fa7311dd",
    "@modelcontextprotocol/sdk": "1.29.0",
    "oidc-provider": "9.12.2",
    "redis": "6.2.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/oidc-provider": "9.12.1",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "mcpName": "io.github.beaconed/beaconed-mcp"
}
